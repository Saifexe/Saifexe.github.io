---
/* Eng / Fr pill. The thumb slides with a stretch; scripts/main.ts runs the switch and its loader. */
---

<button class="lang-switch" type="button" data-lang-switch data-i18n-skip aria-label="Switch to French">
  <span class="ls-thumb" aria-hidden="true"></span>
  <span class="ls-opt" lang="en" aria-hidden="true">
    Eng
  </span>
  <span class="ls-opt" lang="fr" aria-hidden="true">
    Fr
  </span>
</button>
