---
import { Image } from 'astro:assets';
import SectionTitle from './SectionTitle.astro';
import { beyond } from '../data/site';
---

{beyond.length > 0 && (
  <section id="beyond">
    <div class="wrap">
      <SectionTitle label="off the clock" title="Beyond the *code*" />
      <div class="beyond-grid" data-stagger>
        {beyond.map((b) => (
          <div class="beyond-item">
            {b.image && (
              <Image src={b.image} alt={b.alt ?? ''} widths={[420, 760]} sizes="(max-width: 900px) 92vw, 360px" />
            )}
            <div class="txt">
              <h3>{b.title}</h3>
              <p>{b.text}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>
)}
