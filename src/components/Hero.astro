---
import { Image } from 'astro:assets';
import portrait from '../assets/img/saif.jpg';
import { site } from '../data/site';
import Note from './Note.astro';
---

<header class="hero" id="top">
  <div class="glow" aria-hidden="true"></div>
  <!-- Three.js "commit to cluster" scene. Loaded after the page is interactive; the CSS glow stays as the fallback. -->
  <canvas class="hero-canvas" id="hero-canvas" aria-hidden="true"></canvas>
  <div class="wrap">
    <div>
      <p class="quote" data-hero>
        From commit to <em class="hl">cluster.</em>
      </p>
      <h1 id="hero-name" aria-label={site.name}>
        <span class="line" data-hero-line>
          {site.first}
        </span>
        <span class="line" data-hero-line>
          {site.last}
          <span class="dot-accent">.</span>
        </span>
      </h1>
      <svg class="scribble" viewBox="0 0 420 22" aria-hidden="true">
        <path id="scribble" d="M4 14 C 60 6, 120 18, 180 11 S 300 4, 350 12 S 400 15, 414 9" />
      </svg>
      <p class="tracks" data-hero>
        {site.tracks.join(' · ')}
      </p>
      <p class="lede" data-hero>
        {site.lede}
      </p>
      <div class="cta" data-hero>
        <a class="btn solid" href="/#work" data-travel data-magnetic>
          See my work{' '}
          <span class="arr" aria-hidden="true">
            →
          </span>
        </a>
        <details class="cv-menu">
          <summary class="btn">
            Download CV <span aria-hidden="true">▾</span>
          </summary>
          <div class="cv-pop">
            {site.cv.map((c) => (
              <a href={c.href} rel="noopener noreferrer">
                {c.label} <span>PDF</span>
              </a>
            ))}
          </div>
        </details>
        <a class="btn" href="/#contact" data-open-contact>
          Get in touch
        </a>
      </div>
    </div>

    <div class="portrait hero-photo" id="hero-photo" data-hero>
      <div class="frame">
        <!-- 1024 px studio portrait: sharp on 2x screens at the frame's ~365 px width. -->
        <Image
          src={portrait}
          alt={`Portrait of ${site.name}`}
          widths={[380, 560, 760]}
          sizes="(max-width: 980px) 320px, 365px"
          quality={90}
          loading="eager"
          fetchpriority="high"
        />
      </div>
      <div class="tagline">
        <span>{site.location}</span>
        <span>
          <b>●</b> open to opportunities
        </span>
      </div>
      <Note text="hi, that's me!" arrow="right" class="note-hero" tilt="r" />
    </div>
  </div>
  <div class="scroll-cue" aria-hidden="true">
    <span>scroll</span>
    <i></i>
  </div>
</header>
