---
import { site } from '../data/site';
const year = new Date().getFullYear();
---

<footer class="fine">
  <div class="wrap">
    <span>
      © {year} {site.name} · built by hand in Sousse
    </span>
    <span>{site.tagline}</span>
  </div>
</footer>
<dialog class="lb" id="lightbox" aria-label="Image viewer" data-lenis-prevent>
  <img id="lb-img" alt="" />
  <div class="bar">
    <span id="lb-cap"></span>
    <button class="btn small" type="button" id="lb-close">
      Close
    </button>
  </div>
</dialog>
