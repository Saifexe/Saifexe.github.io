---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Footer from '../../components/Footer.astro';
import { hl, plain } from '../../lib/hl';
import LangSwitch from '../../components/LangSwitch.astro';

export async function getStaticPaths() {
  const projects = await getCollection('projects', (p) => Boolean(p.data.caseStudy));
  return projects.map((p) => ({ params: { slug: p.id }, props: { project: p } }));
}

const { project } = Astro.props;
const cs = project.data.caseStudy!;
const { Content } = await render(project);
const ogImage = project.data.highlights?.gallery[0]?.src;
---

<Base title={plain(cs.title)} description={cs.summary} ogImage={ogImage} type="article">
  <div class="cs-bar">
    <div class="wrap">
      <a class="crumb" href="/#work">
        work / <b>{project.id}</b>
      </a>
      <div class="cs-bar-right">
        <LangSwitch />
        <a class="btn small back" href="/#work">
          <span aria-hidden="true">←</span>
          <span class="back-label">Back</span>
        </a>
      </div>
    </div>
  </div>
  <main id="main">
    <header class="cs-hero">
      <div class="wrap">
        <div class="kicker" data-hero>
          <span>Case study</span>
          {project.data.kicker.map((k) => (
            <span>{k}</span>
          ))}
        </div>
        <h1 class={`vt-${project.id}`} data-split set:html={hl(cs.title)} />
        <p class="sum" data-hero>
          {cs.summary}
        </p>
        <div class="meta" data-stagger>
          {cs.meta.map((m) => (
            <div>
              <div class="k">{m.k}</div>
              <div class="v">{m.v}</div>
            </div>
          ))}
        </div>
      </div>
    </header>
    <Content />
    {cs.next && (
      <div class="cs-next">
        <div class="wrap">
          <a class="big" href={`/work/${cs.next}/`}>
            <span class="k">Next case study →</span>
            <h3>{cs.nextLabel}</h3>
          </a>
        </div>
      </div>
    )}
  </main>
  <Footer />
</Base>
